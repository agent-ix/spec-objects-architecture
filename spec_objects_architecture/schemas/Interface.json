{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/0.3.0/Interface.json",
  "type": "object",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/OperationDecl.json"
      },
      "minItems": 1
    },
    "associated_types": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/TypeRef.json"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/ClauseRef.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/RelationDecl.json"
      }
    }
  },
  "required": [
    "operations"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A contract within the system: the operations a component exposes or depends\non. `fields` is forbidden by the seal — an interface declares calls, not\nstate."
}
