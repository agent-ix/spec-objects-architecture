{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/ApiEndpoint.json",
  "type": "object",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/OperationDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/ReturningOperation.json"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/RouteDecl.json"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/ClauseRef.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/RelationDecl.json"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/SemanticId.json"
      }
    }
  },
  "required": [
    "operations"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A network-addressable endpoint. It declares operations, not data: `fields`\nis forbidden by the seal, and at least one operation answers with a record."
}
