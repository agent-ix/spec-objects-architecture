{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/LayoutField.json",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/Identifier.json"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "size": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/Identifier.json"
        }
      ]
    },
    "type": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/LayoutType.json"
    }
  },
  "required": [
    "name",
    "offset",
    "size",
    "type"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One physical field of a binary record.\n\nA `size` naming an `Identifier` names a sibling field of the same record\nwhose value carries the length; that cross-reference is a reader rule."
}
