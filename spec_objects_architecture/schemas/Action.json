{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/Action.json",
  "type": "object",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.1/OperationDecl.json"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.1/ClauseRef.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.1/RelationDecl.json"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.1/SemanticId.json"
      }
    }
  },
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One invokable behaviour. Exactly one operation: an action that declared two\ninvocations would be a process. `fields` is forbidden by the seal."
}
