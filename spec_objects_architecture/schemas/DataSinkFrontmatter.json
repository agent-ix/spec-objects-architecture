{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/DataSinkFrontmatter.json",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "ui_screen",
        "log",
        "export_file",
        "analytics_event",
        "llm_prompt",
        "tool_call",
        "outbound_message",
        "datastore"
      ]
    },
    "processor_agreement": {
      "type": "string",
      "enum": [
        "covered",
        "not_covered",
        "not_applicable",
        "unknown"
      ]
    }
  },
  "required": [
    "kind",
    "processor_agreement"
  ],
  "unevaluatedProperties": {},
  "description": "Open frontmatter fields used by data-sink flow-rule conditions."
}
